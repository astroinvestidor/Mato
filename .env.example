# ==============================================================================
# PROJETO MATO - VARIÁVEIS DE AMBIENTE
# Preencha estas chaves para conectar seu projeto Supabase e Provedores reais.
# ==============================================================================

# Supabase (Banco de Dados, Autenticação e Storage)
VITE_SUPABASE_URL=https://seu-projeto.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anonima-publica

# Pagamentos (Configuração para backend/Edge Functions - NUNCA expor no cliente)
PAYMENT_GATEWAY_WEBHOOK_SECRET=seu_webhook_secret_hmac
PIX_KEY=sua_chave_pix_oficial

# MATO IA (Configuração para backend/Edge Functions)
AI_BACKEND_API_KEY=sua_chave_llm_segura
AI_MODEL_NAME=gemini-1.5-pro
